# Large sample/test datasets
*.gbff
*.gbk
*.gb

# Synthetic regression fixtures are part of the test suite.
!tests/fixtures/
!tests/fixtures/*.gb
!tests/fixtures/*.gbk
!tests/fixtures/*.gbff

# Python bytecode & cache
__pycache__/
*.pyc
.pytest_cache/
.pytest_tmp/
*.egg-info/
build/
dist/

# Scratch & temporary test artifacts
scratch/
scratch_test.*

# Output data artifacts from script runs
*.fna
*.ffn
*.faa
*.gff3
*_summary.tsv
gene_matrix.tsv
