{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whyadr.github.io/genbank-parser/schemas/feature-v1.schema.json",
  "title": "gbparse feature v1",
  "type": "object",
  "required": ["schema_version", "record", "feature_index", "type", "segments", "qualifiers", "xrefs"],
  "properties": {
    "schema_version": {"const": "gbparse.feature.v1"},
    "source": {"type": "string"},
    "record": {"type": "string"},
    "record_index": {"type": "integer", "minimum": 1},
    "feature_index": {"type": "integer", "minimum": 1},
    "type": {"type": "string"},
    "locus_tag": {"type": ["string", "null"]},
    "gene": {"type": ["string", "null"]},
    "product": {"type": ["string", "null"]},
    "protein_id": {"type": ["string", "null"]},
    "start": {"type": "integer", "minimum": 1},
    "end": {"type": "integer", "minimum": 1},
    "strand": {"type": "string", "enum": ["+", "-", "?", "."]},
    "strand_value": {"type": ["integer", "null"]},
    "length": {"type": "integer", "minimum": 0},
    "record_length": {"type": "integer", "minimum": 0},
    "topology": {"type": ["string", "null"]},
    "partial": {"type": "boolean"},
    "pseudo": {"type": "boolean"},
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["start", "end"],
        "properties": {
          "start": {"type": "integer", "minimum": 1},
          "end": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "qualifiers": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
    "xrefs": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
    "xref_sources": {"type": "object"}
  },
  "additionalProperties": true
}
