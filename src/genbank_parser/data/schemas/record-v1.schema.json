{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WhyAdr/genbank-parser/schemas/record-v1.schema.json",
  "title": "gbparse record projection v1",
  "type": "object",
  "required": ["schema_version", "source", "record_index", "id", "name", "description", "length", "topology", "molecule_type", "division", "date", "accessions", "organism", "taxonomy", "strain", "isolate", "gc_percent", "feature_count", "cds_count", "rrna_count", "trna_count", "tmrna_count", "ncrna_count", "pseudogene_count", "has_sequence"],
  "properties": {
    "schema_version": {"const": "gbparse.record.v1"},
    "source": {"type": "string"},
    "record_index": {"type": "integer", "minimum": 1},
    "id": {"type": "string"},
    "name": {"type": "string"},
    "description": {"type": "string"},
    "length": {"type": "integer", "minimum": 0},
    "topology": {"type": ["string", "null"]},
    "molecule_type": {"type": ["string", "null"]},
    "division": {"type": ["string", "null"]},
    "date": {"type": ["string", "null"]},
    "accessions": {"type": "array", "items": {"type": "string"}},
    "organism": {"type": ["string", "null"]},
    "taxonomy": {"type": "array", "items": {"type": "string"}},
    "strain": {"type": ["string", "null"]},
    "isolate": {"type": ["string", "null"]},
    "gc_percent": {"type": "number", "minimum": 0, "maximum": 100},
    "feature_count": {"type": "integer", "minimum": 0},
    "cds_count": {"type": "integer", "minimum": 0},
    "rrna_count": {"type": "integer", "minimum": 0},
    "trna_count": {"type": "integer", "minimum": 0},
    "tmrna_count": {"type": "integer", "minimum": 0},
    "ncrna_count": {"type": "integer", "minimum": 0},
    "pseudogene_count": {"type": "integer", "minimum": 0},
    "has_sequence": {"type": "boolean"}
  },
  "additionalProperties": false
}
