{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WhyAdr/genbank-parser/schemas/index-status-v1.schema.json",
  "title": "gbparse index status v1",
  "type": "object",
  "required": ["schema_version", "database", "metadata", "counts", "feature_type_counts", "topology_counts", "database_size_bytes", "duplicate_content_hashes"],
  "properties": {
    "schema_version": {"const": "gbparse.index-status.v1"},
    "database": {"type": "string"},
    "metadata": {"type": "object", "additionalProperties": {"type": "string"}},
    "counts": {"type": "object", "required": ["sources", "records", "features"], "additionalProperties": {"type": "integer", "minimum": 0}},
    "feature_type_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "topology_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "database_size_bytes": {"type": "integer", "minimum": 0},
    "duplicate_content_hashes": {"type": "array"},
    "source_checks": {"type": "array"},
    "checks": {"type": "object"}
  },
  "additionalProperties": false
}
